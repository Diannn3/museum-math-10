---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  themeColor?: string;
  preloadImage?: string;
}

const {
  title = "MATH × ART — A Digital Exhibition",
  description = "A digital exhibition exploring mathematical ideas through visual art, geometry, sound, and code.",
  themeColor = "#f4f1ea",
  preloadImage
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    {preloadImage && <link rel="prefetch" href={preloadImage} as="image" />}
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
  </body>
</html>
