---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { exhibits } from "../data/exhibits";
import "../styles/exhibition.css";
---

<BaseLayout
  title="The Exhibition — MATH × ART"
  description="Explore a digital MATH 10 exhibition of mathematical visual art and interactive audiovisual work."
>
  <div class="exhibition-shell">
    <SiteHeader current="exhibition" />

    <main id="main-content" class="collection">
      <header class="collection__intro">
        <p class="eyebrow">Collection · {String(exhibits.length).padStart(2, "0")} works</p>
        <h1>The Exhibition</h1>
        <p>
          Move through the collection at your own pace. Select a work to enter its
          gallery wall, read its label, and explore how mathematical structure becomes
          visual or audible form.
        </p>
      </header>

      <ol class="collection-grid" aria-label="Exhibition works">
        {exhibits.map((exhibit) => (
          <li class="collection-card">
            <a class="collection-card__link" href={`/work/${exhibit.slug}`}>
              <figure class="collection-card__figure">
                <img
                  src={exhibit.image}
                  alt={exhibit.alt}
                  width="900"
                  height="700"
                  loading={exhibit.number === "01" ? "eager" : "lazy"}
                  decoding="async"
                />
              </figure>

              <div class="collection-card__meta">
                <p class="collection-card__number">{exhibit.number}</p>
                <h2>{exhibit.title}</h2>
                <p class="collection-card__subtitle">{exhibit.subtitle}</p>
                <p class="collection-card__medium">{exhibit.medium}</p>
                {exhibit.kind === "interactive" && (
                  <span class="collection-card__badge">Interactive work</span>
                )}
              </div>
            </a>
          </li>
        ))}
      </ol>
    </main>

    <footer class="collection-footer">
      <p>MATH 10 · 2026</p>
      <a href="/">Return to entrance</a>
    </footer>
  </div>
</BaseLayout>
