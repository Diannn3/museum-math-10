---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import ExhibitionRail from "../../components/ExhibitionRail.astro";
import { exhibits, getExhibitNeighbors, type Exhibit } from "../../data/exhibits";
import "../../styles/gallery.css";

export function getStaticPaths() {
  return exhibits.map((exhibit) => ({
    params: { slug: exhibit.slug },
    props: { exhibit }
  }));
}

interface Props {
  exhibit: Exhibit;
}

const { exhibit } = Astro.props;
const { previous, next } = getExhibitNeighbors(exhibit.slug);
const total = String(exhibits.length).padStart(2, "0");
---

<BaseLayout
  title={`${exhibit.title} — MATH × ART`}
  description={exhibit.summary}
  themeColor={exhibit.kind === "interactive" ? "#0b0b11" : "#f4f1ea"}
  preloadImage={next?.image}
>
  <div
    class:list={["work-shell", exhibit.kind === "interactive" && "work-shell--interactive"]}
    data-work
  >
    <SiteHeader current="exhibition" tone={exhibit.kind === "interactive" ? "dark" : "light"} />

    <div class="work-wayfinding">
      <ExhibitionRail currentSlug={exhibit.slug} tone={exhibit.kind === "interactive" ? "dark" : "light"} />
    </div>

    <main id="main-content" class="work">
      <div class="work__navigation work__navigation--previous">
        {previous ? (
          <a
            href={`/work/${previous.slug}`}
            class="work-nav"
            rel="prev"
            data-nav="previous"
            aria-keyshortcuts="ArrowLeft"
            aria-label={`Previous work: ${previous.title}`}
          >
            <span class="work-nav__arrow" aria-hidden="true">←</span>
            <span>Previous</span>
          </a>
        ) : (
          <span class="work-nav work-nav--disabled" aria-hidden="true">
            <span class="work-nav__arrow">←</span>
            <span>Previous</span>
          </span>
        )}
      </div>

      <figure class="work__art">
        <div class="work__frame" style={`view-transition-name: art-${exhibit.slug}`}>
          <img
            src={exhibit.image}
            alt={exhibit.alt}
            width={exhibit.imageWidth}
            height={exhibit.imageHeight}
            decoding="async"
            fetchpriority="high"
          />
        </div>
      </figure>

      <article class="work__label" aria-labelledby="work-title">
        <p class="work__count">{exhibit.number} / {total}</p>
        <h1 id="work-title" style={`view-transition-name: title-${exhibit.slug}`}>{exhibit.title}</h1>
        <p class="work__subtitle">{exhibit.subtitle}</p>
        <div class="work__rule" aria-hidden="true"></div>

        <p class="work__summary">{exhibit.summary}</p>

        <dl class="work__facts">
          <div>
            <dt>Artist</dt>
            <dd>{exhibit.artist}</dd>
          </div>
          <div>
            <dt>Medium</dt>
            <dd>{exhibit.medium}</dd>
          </div>
        </dl>

        {exhibit.kind === "interactive" && (
          <section class="interactive-actions" aria-label="Interactive work actions">
            <p class="work__interactive-note">
              The museum view is a preview. Enter the live piece to hear the sonification
              and watch the canonical Fibonacci modulo-25 events construct the visual.
              Audio begins only after you press Play inside the work.
            </p>
            <div class="interactive-actions__links">
              {exhibit.interactiveUrl && (
                <a
                  class="interactive-actions__primary"
                  href={exhibit.interactiveUrl}
                  target="_blank"
                  rel="noreferrer"
                >
                  Enter interactive work <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span>
                </a>
              )}
              {exhibit.externalRepository && (
                <a
                  class="interactive-actions__secondary"
                  href={exhibit.externalRepository}
                  target="_blank"
                  rel="noreferrer"
                >
                  View source<span class="sr-only"> (opens in a new tab)</span>
                </a>
              )}
            </div>
          </section>
        )}
      </article>

      <div class="work__navigation work__navigation--next">
        {next ? (
          <a
            href={`/work/${next.slug}`}
            class="work-nav"
            rel="next"
            data-nav="next"
            aria-keyshortcuts="ArrowRight"
            aria-label={`Next work: ${next.title}`}
          >
            <span class="work-nav__arrow" aria-hidden="true">→</span>
            <span>Next</span>
          </a>
        ) : (
          <a
            href="/closing"
            class="work-nav"
            data-nav="next"
            aria-keyshortcuts="ArrowRight"
            aria-label="Finish the exhibition"
          >
            <span class="work-nav__arrow" aria-hidden="true">↗</span>
            <span>Finish</span>
          </a>
        )}
      </div>
    </main>

    {exhibit.processImage && (
      <aside class="process" aria-labelledby="process-title">
        <details class="process__details">
          <summary>
            <span>
              <span class="eyebrow">Behind the work</span>
              <strong id="process-title">See the construction</strong>
            </span>
            <span class="process__toggle" aria-hidden="true">+</span>
          </summary>
          <div class="process__body">
            <div class="process__copy">
              <h2>The construction is part of the artwork.</h2>
              <p>
                The graphing view exposes a portion of the mathematical process used to
                build the final flower. It is shown as supporting material rather than as
                a second exhibit.
              </p>
            </div>
            <figure class="process__figure">
              <img
                src={exhibit.processImage}
                alt={exhibit.processAlt ?? ""}
                width={exhibit.processWidth}
                height={exhibit.processHeight}
                loading="lazy"
                decoding="async"
              />
            </figure>
          </div>
        </details>
      </aside>
    )}

    <footer class="work-footer">
      <a href="/exhibition">View all works</a>
      <span>Use ← and → to move through the gallery</span>
    </footer>
  </div>

  <script is:inline>
    (() => {
      const shell = document.querySelector("[data-work]");
      if (!shell) return;

      document.addEventListener("keydown", (event) => {
        const target = event.target;
        if (
          target instanceof HTMLElement &&
          (target.tagName === "INPUT" ||
            target.tagName === "TEXTAREA" ||
            target.tagName === "SELECT" ||
            target.isContentEditable)
        ) {
          return;
        }

        const direction =
          event.key === "ArrowLeft"
            ? "previous"
            : event.key === "ArrowRight"
              ? "next"
              : null;

        if (!direction) return;

        const link = shell.querySelector(`[data-nav="${direction}"]`);
        if (link instanceof HTMLAnchorElement) {
          event.preventDefault();
          window.location.assign(link.href);
        }
      });
    })();
  </script>
</BaseLayout>
